[ req ]
default_bits        = 2048
prompt              = no
default_md          = sha256
distinguished_name  = dn
req_extensions      = req_ext

[ dn ]
C  = NP
ST = Bagmati
L  = Kathmandu
O  = MyOrganization
OU = IT
CN = myapp.example.com

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = myapp.example.com
DNS.2 = www.myapp.example.com
